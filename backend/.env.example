# Propagation Studio - Backend Environment Variables

# Port to listen on (Railway injects PORT automatically)
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?|https://.*\.vercel\.app

# Algorithm and Server Tuning
MAX_DATASET_SIZE=500
DEFAULT_K=6
DEFAULT_SIGMA=1.0
DEFAULT_MAX_ITER=200
DEFAULT_TOL=0.0001
SESSION_TTL_SECONDS=3600
STREAM_DELAY_SECONDS=0.01
